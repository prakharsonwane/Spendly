# Spendly configuration example

# Replace this with a long, random secret before deployment.
SPENDLY_SECRET_KEY=replace-with-a-long-random-secret

# Local development database.
# The app will use this default when DATABASE_URL is not set.
DATABASE_URL=sqlite:///spendly_v2.db

# Set to 1 only when running behind HTTPS in production.
COOKIE_SECURE=0